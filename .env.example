# Copie este arquivo para .env e preencha com a configuração local do PostgreSQL.
# Não coloque a senha real neste exemplo nem no GitHub.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ev_brasil_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=preencha_localmente

# Opcional: a coleta Open Charge Map só roda quando você tiver uma chave própria.
# OCM_API_KEY=
